<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Koiny — L'argent de poche qui éduque vos enfants</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --indigo-900:#1E1B4B;
    --indigo-800:#2A2580;
    --indigo-700:#3730A3;
    --indigo-600:#4F46E5;
    --indigo-500:#6366F1;
    --indigo-100:#EEF2FF;
    --indigo-50:#F5F7FF;
    --amber:#F59E0B;
    --amber-soft:#FCD34D;
    --slate-900:#0F172A;
    --slate-700:#334155;
    --slate-500:#64748B;
    --slate-400:#94A3B8;
    --slate-200:#E2E8F0;
    --slate-100:#F1F5F9;
    --slate-50:#F8FAFC;
    --bg:#FAFAFB;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--slate-900);font-family:"Plus Jakarta Sans","Inter",system-ui,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}
  .container{max-width:1280px;margin:0 auto;padding:0 32px}
  .eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--indigo-700)}
  h1,h2,h3,h4{font-family:"Plus Jakarta Sans",sans-serif;letter-spacing:-.02em;margin:0;color:var(--slate-900)}
  p{margin:0;color:var(--slate-500);line-height:1.6}
  .section{padding:120px 0;position:relative}
  .section-title{font-size:52px;font-weight:800;line-height:1.05;text-wrap:balance}
  .section-sub{font-size:18px;color:var(--slate-500);max-width:640px;margin:20px auto 0;text-align:center;text-wrap:pretty}
  .center{text-align:center}

  /* NAV */
  .nav{position:sticky;top:0;z-index:50;backdrop-filter:saturate(180%) blur(18px);-webkit-backdrop-filter:saturate(180%) blur(18px);background:rgba(255,255,255,.78);border-bottom:1px solid rgba(15,23,42,.06)}
  .nav-inner{display:flex;align-items:center;justify-content:space-between;padding:18px 32px;max-width:1280px;margin:0 auto}
  .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:20px;letter-spacing:-.01em}
  .brand-mark{width:34px;height:34px;border-radius:10px;overflow:hidden;display:grid;place-items:center}
  .brand-mark img{width:34px;height:34px;display:block}
  .nav-links{display:flex;gap:36px;font-size:15px;font-weight:500;color:var(--slate-700)}
  .nav-links a{transition:color .15s}
  .nav-links a:hover{color:var(--indigo-700)}
  .nav-cta{display:inline-flex;align-items:center;gap:8px;background:var(--indigo-700);color:#fff;padding:11px 20px;border-radius:999px;font-weight:600;font-size:14.5px;box-shadow:0 8px 24px -10px rgba(55,48,163,.65);transition:transform .15s,background .15s}
  .nav-cta:hover{background:var(--indigo-800);transform:translateY(-1px)}

  /* HERO */
  .hero{position:relative;overflow:hidden;background:radial-gradient(1200px 600px at 80% -10%,#5046C7 0%,transparent 60%),radial-gradient(900px 500px at -10% 30%,#2A2580 0%,transparent 55%),linear-gradient(180deg,#1E1B4B 0%,#2A2580 55%,#3730A3 100%);color:#fff;padding:96px 0 120px}
  .hero::before,.hero::after{content:"";position:absolute;border-radius:50%;filter:blur(80px);opacity:.55;pointer-events:none}
  .hero::before{width:520px;height:520px;background:radial-gradient(circle,#7C77E9,transparent 60%);top:-160px;right:-120px}
  .hero::after{width:420px;height:420px;background:radial-gradient(circle,#F59E0B,transparent 60%);bottom:-180px;left:-100px;opacity:.18}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center;position:relative;z-index:1}
  .hero-pill{display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);padding:8px 14px;border-radius:999px;font-size:13px;font-weight:600;color:#E0E7FF;backdrop-filter:blur(10px)}
  .hero-pill .dot{width:7px;height:7px;border-radius:50%;background:var(--amber);box-shadow:0 0 0 4px rgba(245,158,11,.25)}
  .hero h1{color:#fff;font-size:76px;font-weight:800;line-height:1.02;margin:24px 0 22px;letter-spacing:-.025em}
  .hero h1 .grad{background:linear-gradient(135deg,#FCD34D 0%,#F59E0B 60%,#FBBF24 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
  .hero p.lead{color:#C7CBEE;font-size:20px;line-height:1.55;max-width:520px}
  .hero-cta-row{display:flex;align-items:center;gap:14px;margin-top:36px;flex-wrap:wrap}
  .ghost-btn{display:inline-flex;align-items:center;gap:10px;padding:14px 22px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.22);color:#fff;font-weight:600;font-size:15px;backdrop-filter:blur(10px);transition:background .15s,transform .15s}
  .ghost-btn:hover{background:rgba(255,255,255,.14);transform:translateY(-1px)}
  .badges{display:flex;gap:12px;margin-top:28px;flex-wrap:wrap}
  .badge{display:inline-flex;align-items:center;gap:12px;background:#000;color:#fff;padding:11px 20px;border-radius:14px;border:1px solid rgba(255,255,255,.1);transition:transform .15s,box-shadow .15s;min-width:185px}
  .badge:hover{transform:translateY(-2px);box-shadow:0 12px 28px -12px rgba(0,0,0,.5)}
  .badge svg{width:24px;height:24px;flex-shrink:0}
  .badge .b-top{font-size:10.5px;letter-spacing:.04em;opacity:.85;line-height:1}
  .badge .b-bot{font-size:17px;font-weight:600;line-height:1.1;margin-top:3px;letter-spacing:-.01em}
  .hero-trust{display:flex;gap:24px;margin-top:36px;flex-wrap:wrap;color:#A5A8D9;font-size:13.5px}
  .hero-trust span{display:inline-flex;align-items:center;gap:8px}
  .hero-trust svg{width:14px;height:14px;color:var(--amber-soft)}

  /* PHONE MOCKUP */
  .phone-wrap{position:relative;display:flex;justify-content:center;align-items:center;min-height:680px}
  .phone-glow{position:absolute;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,.35) 0%,transparent 60%);filter:blur(40px);z-index:0}
  .phone{position:relative;width:300px;height:610px;background:#0a0a0a;border-radius:48px;padding:10px;box-shadow:0 30px 80px -20px rgba(0,0,0,.55),0 0 0 2px rgba(255,255,255,.05),inset 0 0 0 1px rgba(255,255,255,.08);z-index:1}
  .phone-screen{width:100%;height:100%;border-radius:38px;background:linear-gradient(180deg,#3730A3 0%,#4F46E5 100%);overflow:hidden;position:relative;display:flex;flex-direction:column}
  .notch{position:absolute;top:10px;left:50%;transform:translateX(-50%);width:110px;height:32px;background:#000;border-radius:20px;z-index:5}
  .status-bar{display:flex;justify-content:space-between;align-items:center;padding:14px 28px 8px;font-size:13px;font-weight:600;color:#fff;font-family:"Inter",sans-serif}
  .status-icons{display:flex;gap:5px;align-items:center}
  .status-icons svg{width:14px;height:14px}
  .p-header{display:flex;justify-content:space-between;align-items:center;padding:38px 18px 14px}
  .p-greet{color:rgba(255,255,255,.7);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
  .p-name{color:#fff;font-size:22px;font-weight:800;letter-spacing:-.02em}
  .p-icon-btn{width:32px;height:32px;border-radius:10px;background:rgba(255,255,255,.14);display:grid;place-items:center;color:#fff}
  .p-icon-btn.red{background:#EF4444}
  .p-balance-card{margin:8px 16px 14px;padding:20px;background:linear-gradient(135deg,rgba(255,255,255,.16),rgba(255,255,255,.06));backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.18);border-radius:22px}
  .p-balance-label{color:rgba(255,255,255,.75);font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:700}
  .p-balance{color:#fff;font-size:46px;font-weight:800;letter-spacing:-.03em;line-height:1;margin-top:8px;display:flex;align-items:baseline;gap:4px}
  .p-balance .cents{font-size:24px;opacity:.8}
  .p-coins{display:flex;justify-content:center;gap:6px;margin-top:14px;font-size:20px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.2))}
  .p-goal{margin:0 16px 12px;padding:14px 16px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);border-radius:18px}
  .p-goal-row{display:flex;justify-content:space-between;align-items:center}
  .p-goal-title{color:#fff;font-size:13px;font-weight:700}
  .p-goal-sub{color:rgba(255,255,255,.65);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:600;margin-top:2px}
  .p-goal-amt{color:var(--amber-soft);font-size:14px;font-weight:800}
  .p-progress{height:5px;border-radius:99px;background:rgba(255,255,255,.18);margin-top:10px;overflow:hidden}
  .p-progress-bar{height:100%;width:75%;background:linear-gradient(90deg,#F59E0B,#FBBF24);border-radius:99px}
  .p-progress-meta{display:flex;justify-content:space-between;margin-top:6px;font-size:9.5px;color:rgba(255,255,255,.6);font-weight:600}
  .p-missions-label{color:rgba(255,255,255,.65);font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;padding:0 22px 8px;display:flex;align-items:center;gap:6px}
  .p-mission{margin:0 16px 8px;padding:12px 14px;background:#fff;border-radius:14px;display:flex;align-items:center;gap:10px;box-shadow:0 4px 12px -4px rgba(0,0,0,.15)}
  .p-mission-icon{width:32px;height:32px;border-radius:10px;background:var(--indigo-100);display:grid;place-items:center;color:var(--indigo-700);font-size:16px}
  .p-mission-icon.amber{background:#FEF3C7;color:#D97706}
  .p-mission-body{flex:1;min-width:0}
  .p-mission-title{font-size:11.5px;font-weight:700;color:var(--slate-900);line-height:1.2}
  .p-mission-sub{font-size:9px;color:var(--slate-500);margin-top:2px}
  .p-mission-amt{font-size:13px;font-weight:800;color:var(--indigo-700)}

  /* floating cards */
  .float{position:absolute;background:#fff;border-radius:16px;padding:12px 16px;box-shadow:0 20px 40px -10px rgba(15,23,42,.25),0 0 0 1px rgba(15,23,42,.04);display:flex;align-items:center;gap:12px;z-index:3}
  .float-1{top:80px;right:-30px}
  .float-2{bottom:140px;left:-40px}
  .float-3{bottom:30px;right:-30px}
  .float-ic{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:18px;flex-shrink:0}
  .float-1 .float-ic{background:#DCFCE7;color:#16A34A}
  .float-2 .float-ic{background:#FEF3C7;color:#D97706}
  .float-3 .float-ic{background:#EEF2FF;color:var(--indigo-700)}
  .float-label{font-size:10.5px;color:var(--slate-500);font-weight:600;line-height:1}
  .float-value{font-size:15px;font-weight:800;color:var(--slate-900);margin-top:3px;letter-spacing:-.01em}
  .float-value.green{color:#16A34A}

  @keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  .float-1{animation:floaty 5s ease-in-out infinite}
  .float-2{animation:floaty 6s ease-in-out infinite .8s}
  .float-3{animation:floaty 5.5s ease-in-out infinite .4s}

  /* PAIN POINTS */
  .pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:64px}
  .pain-card{background:#fff;border-radius:24px;padding:36px 32px;border:1px solid var(--slate-100);position:relative;overflow:hidden;transition:transform .25s,box-shadow .25s}
  .pain-card::before{content:"";position:absolute;left:0;top:24px;bottom:24px;width:4px;background:linear-gradient(180deg,var(--indigo-600),var(--indigo-700));border-radius:0 4px 4px 0}
  .pain-card:hover{transform:translateY(-4px);box-shadow:0 24px 48px -20px rgba(55,48,163,.18)}
  .pain-emoji{font-size:32px;margin-bottom:16px}
  .pain-quote{font-style:italic;color:var(--slate-500);font-size:18px;line-height:1.45;margin:0 0 20px;font-weight:500}
  .pain-answer{color:var(--indigo-700);font-weight:700;font-size:16px;line-height:1.4;display:flex;align-items:flex-start;gap:10px}
  .pain-answer svg{width:18px;height:18px;flex-shrink:0;margin-top:3px;color:var(--indigo-600)}

  /* FEATURES */
  .features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:64px}
  .feature{background:#fff;border-radius:22px;padding:32px;border:1px solid var(--slate-100);transition:transform .25s,box-shadow .25s,border-color .25s}
  .feature:hover{transform:translateY(-4px);box-shadow:0 20px 40px -20px rgba(55,48,163,.18);border-color:#DDD9F7}
  .feature-ic{width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#EEF2FF,#E0E7FF);display:grid;place-items:center;color:var(--indigo-700);margin-bottom:24px;font-size:24px}
  .feature h3{font-size:19px;font-weight:700;margin-bottom:8px;letter-spacing:-.01em}
  .feature p{font-size:14.5px;color:var(--slate-500);line-height:1.55}

  /* HOW IT WORKS */
  .how-section{background:linear-gradient(180deg,#fff 0%,var(--indigo-50) 100%)}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:72px;position:relative}
  .steps::before{content:"";position:absolute;top:48px;left:14%;right:14%;height:2px;background-image:linear-gradient(to right,var(--indigo-500) 50%,transparent 0%);background-size:14px 2px;background-repeat:repeat-x;z-index:0}
  .step{position:relative;text-align:center;z-index:1}
  .step-num{width:96px;height:96px;border-radius:30px;background:linear-gradient(135deg,#4F46E5,#3730A3);color:#fff;display:grid;place-items:center;margin:0 auto 28px;font-size:36px;font-weight:800;box-shadow:0 16px 32px -10px rgba(55,48,163,.45);position:relative}
  .step-num::after{content:"";position:absolute;inset:-6px;border-radius:36px;border:2px solid rgba(79,70,229,.18)}
  .step-preview{background:#fff;border-radius:24px;padding:24px;margin-bottom:24px;box-shadow:0 12px 32px -16px rgba(15,23,42,.12);border:1px solid var(--slate-100);min-height:160px;display:flex;flex-direction:column;justify-content:center;gap:10px}
  .step h3{font-size:22px;font-weight:700;margin-bottom:10px}
  .step p{font-size:15px;line-height:1.55}
  .mini-row{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--slate-50);border-radius:12px;font-size:12px;font-weight:600;color:var(--slate-700)}
  .mini-row .av{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#F59E0B,#FBBF24);display:grid;place-items:center;color:#fff;font-size:11px;font-weight:800}
  .mini-row .av.b{background:linear-gradient(135deg,#4F46E5,#3730A3)}
  .mini-row .pin{margin-left:auto;font-family:"Inter",monospace;letter-spacing:.18em;color:var(--indigo-700);font-weight:700}
  .mini-mission{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:var(--slate-50);border-radius:12px;font-size:12.5px;color:var(--slate-700);font-weight:600}
  .mini-mission .amt{color:var(--indigo-700);font-weight:800}
  .mini-validate{display:flex;align-items:center;gap:10px;padding:12px;background:linear-gradient(135deg,#3730A3,#4F46E5);border-radius:12px;color:#fff;font-size:13px;font-weight:700;justify-content:center}
  .mini-validate svg{width:16px;height:16px}
  .ping{display:inline-flex;align-items:center;gap:6px;background:#DCFCE7;color:#15803D;padding:6px 10px;border-radius:99px;font-size:11px;font-weight:700;width:fit-content;margin:0 auto}
  .ping .d{width:6px;height:6px;border-radius:50%;background:#22C55E}

  /* TRUST */
  .trust-section{background:#fff}
  .trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:56px}
  .trust-card{background:var(--slate-50);border-radius:20px;padding:28px 28px;border:1px solid var(--slate-100);transition:background .2s}
  .trust-card:hover{background:#fff;border-color:#DDD9F7;box-shadow:0 12px 32px -20px rgba(15,23,42,.15)}
  .trust-ic{width:44px;height:44px;border-radius:12px;background:#fff;display:grid;place-items:center;font-size:22px;margin-bottom:18px;box-shadow:0 4px 12px -4px rgba(15,23,42,.08)}
  .trust-card h3{font-size:17px;font-weight:700;margin-bottom:6px}
  .trust-card p{font-size:14px;line-height:1.5}

  /* PRICING */
  .pricing-section{background:linear-gradient(180deg,var(--indigo-50) 0%,#fff 100%)}
  .pricing{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:64px;max-width:980px;margin-left:auto;margin-right:auto}
  .plan{background:#fff;border-radius:28px;padding:44px;border:1px solid var(--slate-200);position:relative}
  .plan-tag{font-size:12px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--slate-500)}
  .plan-name{font-size:42px;font-weight:800;letter-spacing:-.02em;margin:14px 0 4px}
  .plan-name .sm{font-size:18px;color:var(--slate-500);font-weight:500;margin-left:6px}
  .plan-meta{color:var(--slate-500);font-size:15px;margin-bottom:32px}
  .plan ul{list-style:none;padding:0;margin:0 0 32px;display:flex;flex-direction:column;gap:14px}
  .plan li{display:flex;align-items:flex-start;gap:12px;font-size:15px;color:var(--slate-700);font-weight:500}
  .plan li svg{width:20px;height:20px;flex-shrink:0;margin-top:1px;color:#22C55E}
  .plan .btn{display:flex;align-items:center;justify-content:center;width:100%;padding:16px;border-radius:14px;font-weight:700;font-size:15.5px;letter-spacing:-.005em;cursor:pointer;border:none;transition:transform .15s}
  .plan .btn:hover{transform:translateY(-1px)}
  .plan-free .btn{background:var(--slate-100);color:var(--slate-900)}
  .plan-free .btn:hover{background:var(--slate-200)}
  .plan-premium{background:linear-gradient(160deg,#2A2580 0%,#3730A3 50%,#4F46E5 100%);color:#fff;border:none;overflow:hidden;box-shadow:0 30px 60px -20px rgba(55,48,163,.5)}
  .plan-premium::before{content:"";position:absolute;top:-100px;right:-100px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,.35),transparent 60%);filter:blur(40px)}
  .plan-premium::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 30% 0%,rgba(255,255,255,.08),transparent 50%);pointer-events:none}
  .plan-premium > *{position:relative;z-index:1}
  .plan-premium .plan-tag{color:rgba(255,255,255,.7)}
  .plan-premium .plan-name{color:#fff}
  .plan-premium .plan-meta{color:rgba(255,255,255,.7)}
  .plan-premium li{color:#fff}
  .plan-premium li svg{color:#FCD34D}
  .recommended-badge{position:absolute;top:24px;right:24px;background:linear-gradient(135deg,#F59E0B,#FBBF24);color:#1E1B4B;padding:6px 14px;border-radius:99px;font-size:11px;font-weight:800;letter-spacing:.06em;box-shadow:0 8px 24px -6px rgba(245,158,11,.55)}
  .price-row{display:flex;align-items:baseline;gap:8px;margin-bottom:6px}
  .price-row .num{font-size:54px;font-weight:800;letter-spacing:-.03em;color:#fff}
  .price-row .per{font-size:16px;color:rgba(255,255,255,.75);font-weight:500}
  .save-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(245,158,11,.18);color:#FCD34D;padding:5px 10px;border-radius:99px;font-size:11.5px;font-weight:700;border:1px solid rgba(245,158,11,.3);margin-left:8px}
  .plan-premium .btn{background:#fff;color:var(--indigo-700)}
  .plan-premium .btn:hover{background:#FCD34D;color:var(--indigo-900)}
  .plan-fine{font-size:12px;color:rgba(255,255,255,.55);margin-top:14px;text-align:center}

  /* FINAL CTA */
  .final{position:relative;overflow:hidden;background:linear-gradient(160deg,#1E1B4B 0%,#2A2580 45%,#3730A3 100%);color:#fff;padding:130px 0;text-align:center}
  .final::before{content:"";position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(245,158,11,.25),transparent 60%);filter:blur(60px);top:-200px;left:50%;transform:translateX(-50%)}
  .final::after{content:"";position:absolute;inset:0;background:radial-gradient(800px 400px at 50% 100%,rgba(124,119,233,.25),transparent 60%);pointer-events:none}
  .final-inner{position:relative;z-index:1;max-width:760px;margin:0 auto}
  .final h2{color:#fff;font-size:64px;font-weight:800;letter-spacing:-.025em;line-height:1.05}
  .final p{color:#C7CBEE;font-size:19px;margin:22px auto 0;max-width:560px}
  .final .badges{justify-content:center;margin-top:44px}
  .final .badge{padding:14px 26px;min-width:220px}
  .final .badge svg{width:28px;height:28px}
  .final .badge .b-top{font-size:11.5px}
  .final .badge .b-bot{font-size:19px}
  .final-note{margin-top:28px;color:#9AA0CE;font-size:13.5px;display:inline-flex;align-items:center;gap:10px}
  .final-note span{display:inline-flex;align-items:center;gap:6px}
  .final-note .sep{opacity:.4}

  /* FOOTER */
  footer{background:#0A0918;color:#A5A8D9;padding:64px 0 32px}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:48px;margin-bottom:48px}
  .foot-brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:800;font-size:22px;margin-bottom:16px}
  .foot p{color:#A5A8D9;font-size:14px;max-width:280px;line-height:1.6}
  .foot h4{color:#fff;font-size:13px;text-transform:uppercase;letter-spacing:.1em;font-weight:700;margin-bottom:18px}
  .foot ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}
  .foot a{color:#A5A8D9;font-size:14.5px;transition:color .15s}
  .foot a:hover{color:#fff}
  .foot-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:24px;display:flex;justify-content:space-between;align-items:center;color:#6B6F99;font-size:13px;flex-wrap:wrap;gap:12px}

  /* fade-in on scroll */
  .reveal{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s ease}
  .reveal.in{opacity:1;transform:none}

  /* LANG BAR */
  .lang-bar{background:var(--slate-50);border-bottom:1px solid var(--slate-100);padding:10px 32px}
  .lang-bar-inner{max-width:1280px;margin:0 auto;display:flex;align-items:center;gap:8px}
  .lang-btn{display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:8px;border:1.5px solid transparent;background:none;cursor:pointer;font-size:13px;font-weight:600;color:var(--slate-500);transition:all .2s;font-family:inherit}
  .lang-btn.active{background:#fff;border-color:var(--indigo-600);color:var(--indigo-700);box-shadow:0 2px 8px rgba(79,70,229,.12)}
  .lang-btn:hover:not(.active){background:#fff;color:var(--slate-900)}

  /* PHONE MOCKUP (screenshot) */
  .phone-device{position:relative;width:300px;height:610px;background:#0a0a0a;border-radius:48px;padding:10px;box-shadow:0 30px 80px -20px rgba(0,0,0,.55),0 0 0 2px rgba(255,255,255,.05),inset 0 0 0 1px rgba(255,255,255,.08)}
  .phone-device::before{content:"";position:absolute;top:10px;left:50%;transform:translateX(-50%);width:110px;height:32px;background:#000;border-radius:20px;z-index:5}
  .phone-device .phone-screen{width:100%;height:100%;border-radius:38px;overflow:hidden;position:relative}
  .phone-device .phone-screen img{width:100%;height:100%;object-fit:cover;display:block}

  @media (max-width:960px){
    .hero-grid{grid-template-columns:1fr;gap:48px}
    .hero h1{font-size:48px}
    .section-title{font-size:36px}
    .final h2{font-size:42px}
    .pain-grid,.features-grid,.steps,.trust-grid,.pricing,.foot-grid{grid-template-columns:1fr}
    .nav-links{display:none}
    .steps::before{display:none}
    .section{padding:80px 0}
  }
</style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <div class="nav-inner">
    <a href="#" class="brand">
      <span class="brand-mark"><img src="logo.png" alt="Koiny" /></span>
      Koiny
    </a>
    <div class="nav-links">
      <a href="#features">Fonctionnalités</a>
      <a href="#how">Comment ça marche</a>
      <a href="#pricing">Tarifs</a>
      <a href="#download">Télécharger</a>
    </div>
    <a href="#download" class="nav-cta">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 16l-5-5h3V4h4v7h3l-5 5zm-7 2h14v2H5v-2z"/></svg>
      Télécharger
    </a>
  </div>
</nav>

<!-- LANG BAR -->
<div class="lang-bar">
  <div class="lang-bar-inner">
    <button class="lang-btn active" data-lang="fr" onclick="setLang('fr')"><span>🇫🇷</span> Français</button>
    <button class="lang-btn" data-lang="en" onclick="setLang('en')"><span>🇬🇧</span> English</button>
    <button class="lang-btn" data-lang="nl" onclick="setLang('nl')"><span>🇳🇱</span> Nederlands</button>
  </div>
</div>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <span class="hero-pill"><span class="dot"></span> Application famille · iOS &amp; Android</span>
        <h1>L'argent de poche qui <span class="grad">éduque</span> vos enfants</h1>
        <p class="lead">Missions, épargne &amp; responsabilité pour toute la famille. Une app premium pensée pour les parents exigeants.</p>
        <div class="hero-cta-row">
          <a href="#how" class="ghost-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            Voir comment ça marche
          </a>
        </div>
        <div class="badges">
          <a class="badge" href="https://apps.apple.com/app/id6760566260" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.467 2.25-1.232 3.014-.84.84-2.2 1.49-3.32 1.42-.13-1.14.41-2.32 1.18-3.05.83-.83 2.3-1.43 3.37-1.38zm4.37 17.05c-.6 1.4-.89 2.02-1.66 3.26-1.08 1.73-2.6 3.88-4.49 3.9-1.68.02-2.11-1.1-4.39-1.08-2.28.01-2.76 1.1-4.44 1.08-1.89-.02-3.34-1.97-4.42-3.7C.97 17.94.42 13.06 2.6 10.07c1.55-2.12 3.99-3.36 6.28-3.36 2.33 0 3.79 1.28 5.71 1.28 1.86 0 2.99-1.28 5.69-1.28 2.04 0 4.19 1.11 5.74 3.03-5.04 2.76-4.22 9.96.72 8.74z"/></svg>
            <div><div class="b-top">Télécharger sur</div><div class="b-bot">App Store</div></div>
          </a>
          <a class="badge" href="https://play.google.com/store/apps/details?id=app.koiny.parent" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path fill="#34D399" d="M3.6 1.5C3.2 1.7 3 2.1 3 2.7v18.6c0 .6.2 1 .6 1.2l10.8-10.5L3.6 1.5z"/><path fill="#60A5FA" d="M17.6 8.3l-3.2-1.8L3.6 1.5l10.8 10.5 3.2-3.7z"/><path fill="#F87171" d="M3.6 22.5l10.8-10.5 3.2 3.7-3.2 1.8-10.8 5z"/><path fill="#FBBF24" d="M20.7 10.5l-3.1-1.8L14.4 12l3.2 3.7 3.1-1.8c1.1-.6 1.1-2.8 0-3.4z"/></svg>
            <div><div class="b-top">Disponible sur</div><div class="b-bot">Google Play</div></div>
          </a>
        </div>
        <div class="hero-trust">
          <span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6 1-4.5 4.5L18 19l-6-3-6 3 1.5-6.5L3 8l6-1z"/></svg> PIN parental</span>
          <span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6 1-4.5 4.5L18 19l-6-3-6 3 1.5-6.5L3 8l6-1z"/></svg> Face ID</span>
          <span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6 1-4.5 4.5L18 19l-6-3-6 3 1.5-6.5L3 8l6-1z"/></svg> Zéro pub</span>
          <span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6 1-4.5 4.5L18 19l-6-3-6 3 1.5-6.5L3 8l6-1z"/></svg> FR · EN · NL</span>
        </div>
      </div>

      <div class="phone-wrap">
        <div class="phone-glow"></div>
        <div class="phone-device" style="z-index:1">
          <div class="phone-screen">
            <img src="screenshots/fr/dashboard-parent.png" alt="Koiny Dashboard" data-i18n-src="screenshots/{lang}/dashboard-parent.png" />
          </div>
        </div>
        <div class="float float-1">
          <div class="float-ic">✓</div>
          <div>
            <div class="float-label">Mission validée</div>
            <div class="float-value green">+2,00 €</div>
          </div>
        </div>
        <div class="float float-2">
          <div class="float-ic">🏆</div>
          <div>
            <div class="float-label">Solde</div>
            <div class="float-value">12,50 €</div>
          </div>
        </div>
        <div class="float float-3">
          <div class="float-ic">🎯</div>
          <div>
            <div class="float-label">Objectif</div>
            <div class="float-value">75% atteint</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PAIN POINTS -->
<section class="section" data-screen-label="Pain points">
  <div class="container">
    <div class="center reveal">
      <div class="eyebrow">Vous reconnaissez-vous ?</div>
      <h2 class="section-title" style="margin-top:14px">Les galères de <span style="color:var(--indigo-700)">l'argent de poche</span></h2>
      <p class="section-sub">Chaque parent fait face aux mêmes questions. Koiny y répond simplement.</p>
    </div>
    <div class="pain-grid">
      <div class="pain-card reveal">
        <div class="pain-emoji">💬</div>
        <p class="pain-quote">"Il n'a rien fait mais réclame de l'argent."</p>
        <div class="pain-answer"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Chaque euro lié à une mission accomplie.</div>
      </div>
      <div class="pain-card reveal">
        <div class="pain-emoji">💸</div>
        <p class="pain-quote">"Elle dépense tout sans jamais épargner."</p>
        <div class="pain-answer"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Objectifs d'épargne visuels et motivants.</div>
      </div>
      <div class="pain-card reveal">
        <div class="pain-emoji">📱</div>
        <p class="pain-quote">"Je ne sais pas combien je lui ai donné."</p>
        <div class="pain-answer"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Historique complet et solde en temps réel.</div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="section" id="features" data-screen-label="Features" style="background:#fff">
  <div class="container">
    <div class="center reveal">
      <div class="eyebrow">Fonctionnalités</div>
      <h2 class="section-title" style="margin-top:14px">Tout ce qu'il faut pour <span style="color:var(--indigo-700)">apprendre en s'amusant</span></h2>
      <p class="section-sub">Un outil pensé pour les parents exigeants qui veulent le contrôle, sans la complexité.</p>
    </div>
    <div class="features-grid">
      <div class="feature reveal">
        <div class="feature-ic">🎯</div>
        <h3>Missions personnalisées</h3>
        <p>Ranger la chambre, faire les devoirs, aider en cuisine... Vous définissez les règles et les récompenses.</p>
      </div>
      <div class="feature reveal">
        <div class="feature-ic">🏦</div>
        <h3>Objectifs d'épargne</h3>
        <p>Vélo, console, jouet… votre enfant fixe un objectif et voit sa progression jour après jour.</p>
      </div>
      <div class="feature reveal">
        <div class="feature-ic">🔒</div>
        <h3>Contrôle parental total</h3>
        <p>PIN chiffré + Face ID pour accéder à l'espace parent. Vos enfants ne peuvent rien modifier.</p>
      </div>
      <div class="feature reveal">
        <div class="feature-ic">📊</div>
        <h3>Suivi &amp; statistiques</h3>
        <p>Historique détaillé, graphiques d'évolution et vue d'ensemble par enfant. Tout en un coup d'œil.</p>
      </div>
      <div class="feature reveal">
        <div class="feature-ic">📱</div>
        <h3>Widget iOS natif</h3>
        <p>Le solde directement sur l'écran d'accueil. Pas besoin d'ouvrir l'app pour vérifier.</p>
      </div>
      <div class="feature reveal">
        <div class="feature-ic">🔕</div>
        <h3>100% privé, zéro pub</h3>
        <p>Aucun tracking, aucune publicité, aucune donnée vendue. Stockage local sur votre téléphone.</p>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section how-section" id="how" data-screen-label="How it works">
  <div class="container">
    <div class="center reveal">
      <div class="eyebrow">Comment ça marche</div>
      <h2 class="section-title" style="margin-top:14px">Lancé en <span style="color:var(--indigo-700)">3 minutes</span></h2>
      <p class="section-sub">Une configuration éclair, une utilisation quotidienne fluide.</p>
    </div>
    <div class="steps">
      <div class="step reveal">
        <div class="step-num">1</div>
        <div class="step-preview">
          <div class="mini-row"><span class="av">L</span> Léo · 8 ans <span class="pin">●●●●</span></div>
          <div class="mini-row"><span class="av b">E</span> Emma · 11 ans <span class="pin">●●●●</span></div>
        </div>
        <h3>Créez les profils</h3>
        <p>Avatar, couleur et PIN parental sécurisé. 2 minutes chrono.</p>
      </div>
      <div class="step reveal">
        <div class="step-num">2</div>
        <div class="step-preview">
          <div class="mini-mission"><span>🛏 Ranger la chambre</span><span class="amt">2 €</span></div>
          <div class="mini-mission"><span>🛒 Faire les courses</span><span class="amt">5 €</span></div>
          <div class="mini-mission"><span>📚 Faire les devoirs</span><span class="amt">3 €</span></div>
        </div>
        <h3>Définissez les missions</h3>
        <p>"Ranger la chambre → 2 €", "Faire les courses → 5 €". Vos règles.</p>
      </div>
      <div class="step reveal">
        <div class="step-num">3</div>
        <div class="step-preview">
          <div class="ping"><span class="d"></span> Léo a terminé sa mission</div>
          <div class="mini-validate"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Valider · +2,00 €</div>
        </div>
        <h3>Ils progressent, vous validez</h3>
        <p>Un tap pour valider. L'argent s'ajoute instantanément à leur cagnotte.</p>
      </div>
    </div>
  </div>
</section>

<!-- TRUST -->
<section class="section trust-section" data-screen-label="Trust">
  <div class="container">
    <div class="center reveal">
      <div class="eyebrow">Pourquoi Koiny</div>
      <h2 class="section-title" style="margin-top:14px">Conçu pour les parents <span style="color:var(--indigo-700)">qui ont des valeurs</span></h2>
      <p class="section-sub">Pas de compromis sur la sécurité, la vie privée ou la pédagogie.</p>
    </div>
    <div class="trust-grid">
      <div class="trust-card reveal">
        <div class="trust-ic">✅</div>
        <h3>100% argent virtuel</h3>
        <p>Aucune carte bancaire, aucun vrai argent engagé. Apprentissage sans risque financier réel.</p>
      </div>
      <div class="trust-card reveal">
        <div class="trust-ic">🔐</div>
        <h3>Données 100% privées</h3>
        <p>Vos données restent sur votre téléphone. Aucune donnée vendue, aucun tracking publicitaire.</p>
      </div>
      <div class="trust-card reveal">
        <div class="trust-ic">⚡</div>
        <h3>Toujours disponible</h3>
        <p>Sauvegardé localement en priorité. Même hors ligne, l'app continue de fonctionner.</p>
      </div>
      <div class="trust-card reveal">
        <div class="trust-ic">🚫</div>
        <h3>Zéro publicité</h3>
        <p>Aucune bannière, aucune notification marketing. Expérience pure pour toute la famille.</p>
      </div>
      <div class="trust-card reveal">
        <div class="trust-ic">📚</div>
        <h3>Pédagogie prouvée</h3>
        <p>Effort-récompense et objectif différé : des méthodes reconnues pour développer la responsabilité.</p>
      </div>
      <div class="trust-card reveal">
        <div class="trust-ic">🎯</div>
        <h3>Simple à utiliser</h3>
        <p>Configuré en 3 minutes. Interface claire pour les enfants dès 6 ans, tableau de bord complet pour les parents.</p>
      </div>
    </div>
  </div>
</section>

<!-- PRICING -->
<section class="section pricing-section" id="pricing" data-screen-label="Pricing">
  <div class="container">
    <div class="center reveal">
      <div class="eyebrow">Tarifs</div>
      <h2 class="section-title" style="margin-top:14px">Simple et <span style="color:var(--indigo-700)">transparent</span></h2>
      <p class="section-sub">Commencez gratuitement. Passez Premium quand votre famille grandit.</p>
    </div>
    <div class="pricing">
      <div class="plan plan-free reveal">
        <div class="plan-tag">Koiny Standard</div>
        <div class="plan-name">Gratuit</div>
        <div class="plan-meta">Pour toujours</div>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> 1 enfant</li>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Max 2 missions actives</li>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Max 1 objectif d'épargne</li>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Historique (5 dernières entrées)</li>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Widget iOS &amp; Face ID</li>
        </ul>
        <button class="btn">Commencer gratuitement</button>
      </div>
      <div class="plan plan-premium reveal">
        <div class="recommended-badge">★ Recommandé</div>
        <div class="plan-tag">Koiny Premium</div>
        <div class="price-row">
          <span class="num">1,99 €</span>
          <span class="per">/ mois</span>
        </div>
        <div class="plan-meta">ou 16,99 €/an <span class="save-badge">Économisez 30%</span></div>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Enfants illimités</li>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Missions &amp; objectifs illimités</li>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Historique complet</li>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Statistiques &amp; graphiques</li>
          <li><svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> 14 jours d'essai gratuit</li>
        </ul>
        <button class="btn">Essayer 14 jours gratuits</button>
        <div class="plan-fine">Annulable à tout moment via les Réglages de votre appareil.</div>
      </div>
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="final" id="download" data-screen-label="Final CTA">
  <div class="container">
    <div class="final-inner reveal">
      <h2>Lancez-vous dès <span style="background:linear-gradient(135deg,#FCD34D,#F59E0B);-webkit-background-clip:text;background-clip:text;color:transparent">aujourd'hui</span></h2>
      <p>Rejoignez les familles qui utilisent Koiny pour motiver leurs enfants au quotidien.</p>
      <div class="badges">
        <a class="badge" href="https://apps.apple.com/app/id6760566260" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.467 2.25-1.232 3.014-.84.84-2.2 1.49-3.32 1.42-.13-1.14.41-2.32 1.18-3.05.83-.83 2.3-1.43 3.37-1.38zm4.37 17.05c-.6 1.4-.89 2.02-1.66 3.26-1.08 1.73-2.6 3.88-4.49 3.9-1.68.02-2.11-1.1-4.39-1.08-2.28.01-2.76 1.1-4.44 1.08-1.89-.02-3.34-1.97-4.42-3.7C.97 17.94.42 13.06 2.6 10.07c1.55-2.12 3.99-3.36 6.28-3.36 2.33 0 3.79 1.28 5.71 1.28 1.86 0 2.99-1.28 5.69-1.28 2.04 0 4.19 1.11 5.74 3.03-5.04 2.76-4.22 9.96.72 8.74z"/></svg>
          <div><div class="b-top">Télécharger sur</div><div class="b-bot">App Store</div></div>
